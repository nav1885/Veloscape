# Copy to scripts/release.env (gitignored) and fill in real values.
# The repo is PUBLIC — never commit real IDs/keys. The .p8 and the Google
# service-account JSON are the actual secrets; keep them off git entirely.

# Apple — App Store Connect API key (for altool upload + xcodebuild provisioning)
ASC_KEY_ID=YOUR_ASC_KEY_ID
ASC_ISSUER=YOUR_ASC_ISSUER_ID
ASC_KEY_PATH="$HOME/Downloads/AuthKey_YOUR_ASC_KEY_ID.p8"
APPLE_TEAM=YOUR_APPLE_TEAM_ID

# Android uploads use `eas submit`, which reads the Google Play service account
# from eas.json (submit.production.android.serviceAccountKeyPath =
# ./google-play-service-account.json). Place that JSON at the repo root
# (gitignored). No Android values are needed in this file.
